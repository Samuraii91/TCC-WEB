<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Área Administrativa - Novo Belém</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
      background: linear-gradient(135deg, #001d3d 0%, #003366 50%, #0055aa 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      position: relative;
      overflow: hidden;
    }

    body::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.08) 0, transparent 45%),
        radial-gradient(circle at 85% 80%, rgba(127, 192, 255, 0.12) 0, transparent 50%);
      pointer-events: none;
    }

    .login-box {
      background: #ffffff;
      padding: 44px 40px 38px;
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      width: 380px;
      max-width: 100%;
      text-align: center;
      position: relative;
    }

    .login-logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
      background: #fff;
      border: 2px solid #e8f1ff;
      border-radius: 16px;
      padding: 6px;
      margin: 0 auto 16px;
      box-shadow: 0 4px 12px rgba(0, 43, 85, 0.12);
    }

    .login-box h2 {
      margin-bottom: 6px;
      color: #002b55;
      font-size: 22px;
      font-weight: 700;
    }

    .login-box p.subtitulo {
      color: #5b6b82;
      font-size: 14px;
      margin-bottom: 24px;
    }

    .login-box input {
      width: 100%;
      margin: 10px 0;
      padding: 13px 14px;
      border: 1px solid #e3e9f2;
      border-radius: 10px;
      font-size: 15px;
      box-sizing: border-box;
      font-family: inherit;
      transition: border-color 0.25s, box-shadow 0.25s;
    }

    .login-box input:focus {
      outline: none;
      border-color: #0066cc;
      box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.25);
    }

    .btn-login {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #0055aa 0%, #0066cc 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      margin-top: 12px;
      box-shadow: 0 4px 12px rgba(0, 85, 170, 0.35);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 85, 170, 0.4);
    }

    .btn-login:active {
      transform: translateY(0);
    }

    .msg-erro {
      color: #d62828;
      font-size: 14px;
      margin-bottom: 10px;
      background: #fdeaea;
      border: 1px solid #f6caca;
      padding: 10px 14px;
      border-radius: 8px;
    }

    .voltar-link {
      margin-top: 18px;
      font-size: 14px;
    }

    .voltar-link a {
      color: #0055aa;
      text-decoration: none;
      font-weight: 500;
    }

    .voltar-link a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="login-box">
    <img src="/img/logo.png" alt="Logo Novo Belém" class="login-logo">
    <h2>Área Administrativa</h2>
    <p class="subtitulo">Digite a senha de acesso para continuar</p>

    <% if (erro) { %>
      <p class="msg-erro"><%= erro %></p>
    <% } %>

    <form action="/admin" method="POST">
      <input type="password" name="senha" placeholder="Senha" required autofocus />
      <button type="submit" class="btn-login">Entrar</button>
    </form>

    
  </div>
</body>
</html>
