        function estrelasHTML(nota) {
            const arred = Math.round(nota);
            let html = "";
            for (let i = 1; i <= 5; i++) {
                html += i <= arred
                    ? '<span class="estrela on">★</span>'
                    : '<span class="estrela">☆</span>';
            }
            return html;
        }

