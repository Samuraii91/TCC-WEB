        function variantesTermo(t) {
            const set = new Set();
            if (t) set.add(t);
            if (t && t.length > 2 && t.endsWith("s")) set.add(t.slice(0, -1));
            else if (t) set.add(t + "s");
            (SINONIMOS[t] || []).forEach(x => set.add(x));
            return [...set];
        }

        function levenshtein(a, b) {
            const m = a.length, n = b.length;
            if (m === 0) return n;
            if (n === 0) return m;
            let anterior = Array.from({ length: n + 1 }, (_, i) => i);
            for (let i = 1; i <= m; i++) {
                const atual = [i];
                for (let j = 1; j <= n; j++) {
                    const custo = a[i - 1] === b[j - 1] ? 0 : 1;
                    atual[j] = Math.min(atual[j - 1] + 1, anterior[j] + 1, anterior[j - 1] + custo);
                }
                anterior = atual;
            }
            return anterior[n];
        }

        function similaridade(a, b) {
            if (!a || !b) return 0;
            if (a === b) return 1;
            const max = Math.max(a.length, b.length);
            if (max === 0) return 1;
            return 1 - levenshtein(a, b) / max;
        }

        // Lista de candidatos baseada nos produtos/categorias realmente cadastrados
        const candidatos = new Set();
        const mapaExibicao = {};

        function adicionarCandidato(texto) {
            const n = removerAcentos(texto.toLowerCase()).trim();
            if (!n) return;
            candidatos.add(n);
            if (!mapaExibicao[n]) mapaExibicao[n] = texto.trim();
        }

        produtos.forEach(p => {
            adicionarCandidato(p.querySelector("h3").textContent);
            const catEl = p.querySelector(".categoria");
            if (catEl) adicionarCandidato(catEl.textContent.replace(/Categoria:\s*/i, "").trim());
        });
        categoriasLista.forEach(c => adicionarCandidato(c.querySelector("h3").textContent));

        function melhorSugestao(termo) {
            if (!termo) return null;
            const termos = variantesTermo(termo);
            let melhor = null;
            let melhorScore = 0;

            candidatos.forEach(cand => {
                const palavras = cand.split(/\s+/);
                let score = similaridade(termo, cand);

                palavras.forEach(w => {
                    score = Math.max(score, similaridade(termo, w));
                });

                termos.forEach(v => {
                    if (v && cand.includes(v)) score = Math.max(score, 0.85);
                    if (v) {
                        palavras.forEach(w => {
                            if (w.includes(v) || (v.length > 2 && v.includes(w))) score = Math.max(score, 0.85);
                        });
                    }
                });

                if (score > melhorScore) {
                    melhorScore = score;
                    melhor = cand;
                }
            });

            return melhorScore >= 0.55 ? melhor : null;
        }

        function aplicarFiltro() {
            const termo = removerAcentos(inputPesquisa.value.toLowerCase().trim());
            const filtro = filtroPesquisa.value;
            const termos = variantesTermo(termo);

            secaoCategorias.style.display = (filtro === "produtos") ? "none" : "";
            secaoProdutos.style.display = (filtro === "categorias") ? "none" : "";

            categoriasLista.forEach(card => {
                const nome = removerAcentos(card.querySelector("h3").textContent.toLowerCase());
                const desc = removerAcentos(card.querySelector("p").textContent.toLowerCase());
                const bate = termos.some(t => t && (nome.includes(t) || desc.includes(t)));
                card.dataset.match = (termo === "" || bate) ? "1" : "0";
            });

            produtos.forEach(card => {
                const nome = removerAcentos(card.querySelector("h3").textContent.toLowerCase());
                let categoria = "";
                const catEl = card.querySelector(".categoria");
                if (catEl) categoria = removerAcentos(catEl.textContent.replace(/Categoria:\s*/i, "").toLowerCase());
                const bate = termos.some(t => t && (nome.includes(t) || categoria.includes(t)));
                const termoOK = termo === "" || bate;
                const catOK = categoriaAtiva === "todos" || card.dataset.categoria === categoriaAtiva;
                card.dataset.match = (termoOK && catOK) ? "1" : "0";
            });

            produtosVisiveis = 4;
            categoriasVisiveis = 5;

            atualizarProdutos();
            atualizarCategorias();

            // ----- Mensagem de nenhum resultado + sugestão -----
            let matchProd = 0, matchCat = 0;
            produtos.forEach(card => { if (card.dataset.match === "1") matchProd++; });
            categoriasLista.forEach(card => { if (card.dataset.match === "1") matchCat++; });
            const visiveis = filtro === "produtos" ? matchProd
                : filtro === "categorias" ? matchCat
                    : matchProd + matchCat;

            const nenhumResultado = document.getElementById("nenhumResultado");
            const buscaSugestao = document.getElementById("buscaSugestao");

            if (termo !== "" && visiveis === 0) {
                document.getElementById("termoNaoEncontrado").textContent = inputPesquisa.value.trim();
                nenhumResultado.style.display = "block";

                const sugestao = melhorSugestao(termo);
                if (sugestao) {
                    const display = mapaExibicao[sugestao] || sugestao;
                    document.getElementById("btnSugestao").textContent = display;
                    document.getElementById("btnSugestao").dataset.sugestao = sugestao;
                    buscaSugestao.style.display = "flex";
                } else {
                    buscaSugestao.style.display = "none";
                }
            } else {
                nenhumResultado.style.display = "none";
                buscaSugestao.style.display = "none";
            }
        }

        inputPesquisa.addEventListener("input", aplicarFiltro);
