        }

        function alternarTema() {
            const temaAtual = document.body.classList.contains("dark-mode") ? "dark" : "light";
            const proximoTema = temaAtual === "dark" ? "light" : "dark";
            localStorage.setItem("theme", proximoTema);
            aplicarTema(proximoTema);
        }

        if (darkModeToggle) {
            darkModeToggle.addEventListener("click", alternarTema);
        }

        const temaSalvo = localStorage.getItem("theme");
        const temaInicial = temaSalvo || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        aplicarTema(temaInicial);

        // ----- Botão voltar ao topo + sombra no cabeçalho -----
        const btnTopo = document.getElementById("voltar-topo");
        const topoSite = document.getElementById("topo-site");

        function onScroll() {
            const passou = window.scrollY > 350;
            btnTopo.classList.toggle("visivel", passou);
            if (topoSite) topoSite.classList.toggle("scrolled", window.scrollY > 10);
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        btnTopo.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // ----- Fecha o menu mobile ao tocar em um link -----
        const menuToggle = document.getElementById("menu-toggle");
        document.querySelectorAll(".menu a").forEach(link => {
            link.addEventListener("click", () => {
                if (menuToggle && menuToggle.checked) menuToggle.checked = false;
            });
        });
    </script>

</body>

</html>
