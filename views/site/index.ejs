<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Novo Belém - Argamassa e Ferragem</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styleSite.css">
</head>

<body>

    <% const normalizarNome = (s) => (s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase(); %>
    <% const notaMedia = (av) => (av && av.length) ? (av.reduce((s, v) => s + v, 0) / av.length) : 0; %>
    <% const DADOS_CONTATO = {
         telefone: "(53) 991027296",
         telefoneLink: "+5553991027296",
         email: "profevinicius@gmail.com",
         whatsappLink: "https://wa.me/5553991027296",
         whatsappTexto: "Olá! Vim pelo site da Novo Belém e gostaria de mais informações."
       }; %>

    <header class="topo" id="topo-site">
        <div class="topo-linha">
            <div class="logo-container">
                <img src="/img/logo.png" class="logo-icon" alt="Logo Novo Belém">
                <div class="logo-textos">
                    <h1>Novo Belém</h1>
                    <span class="subtitulo">Argamassa e Ferragem</span>
                </div>
            </div>

            <input type="checkbox" id="menu-toggle" class="menu-toggle">
            <label for="menu-toggle" class="menu-mobile"></label>

            <nav class="menu">
                <a href="#servicos">Categorias</a>
                <a href="#produtos">Produtos</a>
                <a href="#contato">Orçamento</a>
                <a href="#localizacao">Localização</a>
                <a href="#fale-conosco">Contatos</a>
            </nav>

            <div class="header-acoes">
                <button id="dark-mode-toggle" class="dark-mode-btn" type="button">Modo Escuro</button>
            </div>
        </div>

        <div class="busca-area">
            <div class="busca-bar">
                <input type="text" id="pesquisa" class="busca-input" placeholder="Buscar produtos ou categorias...">
                <select id="filtroPesquisa" class="busca-select">
                    <option value="todos">Todos</option>
                    <option value="categorias">Categorias</option>
                    <option value="produtos">Produtos</option>
                </select>
            </div>

            <div class="busca-sugestao" id="buscaSugestao" style="display:none">
                <span id="sugestaoTexto">Você quis dizer:</span>
                <button type="button" id="btnSugestao" class="btn-sugestao"></button>
            </div>
        </div>
    </header>

    <section class="hero">
        <div class="container hero-content">
            <h2>Materiais de Qualidade para sua Obra</h2>
            <p>Os melhores preços e atendimento personalizado</p>
            <div class="hero-acoes">
                <a href="#produtos" class="btn btn-azul">Ver Produtos</a>
                <a href="#contato" class="btn btn-contorno">Solicitar Orçamento</a>
            </div>
            <div class="hero-info">
                <div class="info-item"><span class="icon">📞</span><span>(53) 991027296</span></div>
                <div class="info-item"><span class="icon">✉️</span><span>profevinicius@gmail.com</span></div>
                <div class="info-item"><span class="icon">🕐</span><span>Seg-Sex: (8h-12h) e (13:30-17:30h) | Sáb:
                        8h-12h</span></div>
            </div>
        </div>
    </section>

    <section id="servicos" class="secao">
        <div class="container">
            <h2 class="titulo-secao">Nossas Categorias</h2>
            <p class="subtitulo-secao">Explore os grupos de materiais que temos disponíveis para sua obra.</p>

            <div class="grid-servicos" id="listaCategorias">
                <% categorias.forEach(cat=> { %>
                    <div class="card-servico">
                        <div class="img-wrapper">
                            <img src="<% if (cat.imagemBase64) { %>
                                    data:<%= cat.mimetype %>;base64,<%= cat.imagemBase64 %>
                                 <% } else { %>
                                    https://via.placeholder.com/300x200?text=Sem+Imagem
                                 <% } %>" alt="<%= cat.nome %>">
                        </div>
                        <div class="card-content">
                            <h3><%= cat.nome %></h3>
                            <p><%= cat.descricao %></p>
                        </div>
                    </div>
                    <% }) %>

                    <% if (categorias.length===0) { %>
                        <p class="estado-vazio">Nenhuma categoria cadastrada ainda.</p>
                        <% } %>
            </div>

            <div class="botoes-paginacao">
                <button id="btnVerMaisCategorias" class="btn btn-azul">Ver mais categorias</button>
                <button id="btnVerMenosCategorias" class="btn btn-azul" style="display:none;">Mostrar menos</button>
            </div>
        </div>
    </section>

    <section id="produtos" class="secao secao-cinza">
        <div class="container">
            <h2 class="titulo-secao">Nossos Produtos</h2>
            <p class="subtitulo-secao">Confira os produtos disponíveis e solicite um orçamento sem compromisso.</p>

            <div class="filtro-categorias" id="filtroCategorias">
                <button type="button" class="pill-categoria ativo" data-cat="todos">Todos</button>
                <% const catsUnicas = []; produtos.forEach(prod => { if (prod.categoria && !catsUnicas.includes(prod.categoria.nome)) catsUnicas.push(prod.categoria.nome); }); %>
                <% catsUnicas.forEach(catNome => { %>
                    <button type="button" class="pill-categoria" data-cat="<%= normalizarNome(catNome) %>"><%= catNome %></button>
                    <% }) %>
            </div>

            <div class="grid-produtos">
                <% produtos.forEach(prod=> { %>
                    <div class="card-produto" data-categoria="<%= prod.categoria ? normalizarNome(prod.categoria.nome) : '' %>" data-produto-id="<%= prod._id %>" data-em-estoque="<%= prod.quantidade > 0 ? 'true' : 'false' %>">
                        <div class="img-wrapper">
                            <img src="<%= prod.imagemBase64 ? `data:${prod.mimetype};base64,${prod.imagemBase64}` : 'https://via.placeholder.com/300x200?text=Sem+Imagem' %>"
                                alt="<%= prod.nome %>">

                            <% if (prod.quantidade > 0) { %>
                                <span class="badge-estoque ok">Em estoque</span>
                                <% } else { %>
                                    <span class="badge-estoque esgotado">Fora de estoque</span>
                                    <% } %>
                        </div>

                        <div class="produto-info">
                            <h3><%= prod.nome %></h3>
                            <p class="preco">R$ <%= prod.preco.toFixed(2) %></p>

                            <div class="produto-avaliacao" data-nota="<%= notaMedia(prod.avaliacoes).toFixed(1) %>" data-avaliacoes="<%= (prod.avaliacoes || []).length %>"></div>

                            <% if (prod.categoria) { %>
                                <p class="categoria"><%= prod.categoria.nome %></p>
                                <% } %>

                                    <div class="produto-descricao-oculta" style="display:none"><%= prod.descricao || '' %></div>

                                    <div class="produto-acoes">
                                        <button type="button" class="btn btn-ver-detalhes">Ver detalhes</button>
                                        <a href="#contato" class="btn btn-azul btn-orcamento" data-produto="<%= prod.nome %>">Solicitar Orçamento</a>
                                        <a href="https://wa.me/5553991027296?text=<%= encodeURIComponent('Olá! Gostaria de saber mais sobre o produto: ' + prod.nome) %>"
                                            class="btn btn-whatsapp" target="_blank" rel="noopener">Pedir via WhatsApp</a>
                                    </div>
                        </div>
                    </div>
                    <% }) %>

                    <% if (produtos.length===0) { %>
                        <p class="estado-vazio">Nenhum produto cadastrado ainda.</p>
                        <% } %>
            </div>

            <div class="nenhum-resultado" id="nenhumResultado" style="display:none">
                Nenhum resultado encontrado para "<span id="termoNaoEncontrado"></span>".
            </div>

            <div class="botoes-paginacao">
                <button id="btnVerMais" class="btn btn-azul">Ver mais produtos</button>
                <button id="btnVerMenos" class="btn btn-azul" style="display:none;">Mostrar menos</button>
            </div>
        </div>
    </section>

    <section id="localizacao" class="secao">
        <div class="container">
            <h2 class="titulo-secao">Nossa Localização</h2>
            <p class="subtitulo-secao">Venha nos visitar ou entre em contato para mais informações.</p>

            <div class="grid-localizacao">
                <div class="card-localizacao">
                    <div class="localizacao-info">
                        <div class="info-header"><span class="icon-grande">📍</span>
                            <h3>Endereço</h3>
                        </div>
                        <p>
                            Rua Próspero Ambrósio Pesce, 220<br>
                            Bairro Passo do Príncipe<br>
                            Bagé - RS<br>
                            CEP 96400-000
                        </p>
                    </div>

                    <div class="horario-info">
                        <h4>Horário de Funcionamento</h4>
                        <p>Segunda a Sexta: (8h-12h) e (13:30-17:30h)</p>
                        <p>Sábado: 8h-12h</p>
                        <p class="fechado">Domingo: Fechado</p>
                    </div>
                </div>

                <div class="mapa">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3292.5216540441243!2d-54.107494729870226!3d-31.344687084025722!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9506750d27fd612d%3A0xf778add48b04070!2sArgamassa%20e%20Material%20de%20Constru%C3%A7%C3%A3o%20Novo%20Bel%C3%A9m!5e0!3m2!1spt-BR!2sbr!4v1763379837572!5m2!1spt-BR!2sbr"
                        width="100%" height="400" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        title="Mapa - Novo Belém">
                    </iframe>
                </div>
            </div>
        </div>
    </section>

    <section id="fale-conosco" class="secao secao-cinza">
        <div class="container">
            <h2 class="titulo-secao">Fale Conosco</h2>
            <p class="subtitulo-secao">Precisa de ajuda que não seja sobre orçamento? Clique no card e veja as formas de contato.</p>

            <div class="grid-fale-conosco">
                <div class="card-localizacao card-fale-conosco" id="btnAbrirContato" role="button" tabindex="0"
                    aria-haspopup="dialog" aria-label="Abrir formas de contato">
                    <div class="localizacao-info">
                        <div class="info-header">
                            <span class="icon-grande">💬</span>
                            <h3>Fale Conosco</h3>
                        </div>
                        <p>Ficou com alguma dúvida que não seja sobre orçamento? Entre em contato conosco através de uma das opções abaixo.</p>
                    </div>
                    <div class="horario-info fale-conosco-cta">
                        <p>📞 Telefone &nbsp;•&nbsp; ✉️ E-mail &nbsp;•&nbsp; 💬 WhatsApp</p>
                        <span class="fale-conosco-vermais">Ver formas de contato →</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contato" class="secao secao-cinza">
        <div class="container">
            <h2 class="titulo-secao">Entre em Contato</h2>
            <p class="subtitulo-secao">Preencha o formulário abaixo e receba seu orçamento rapidamente.</p>

            <div class="formulario-container">
                <form class="formulario" action="https://formspree.io/f/xrbwqlzb" method="POST">
                    <input type="hidden" name="_replyto" value="profevinicius@gmail.com">
                    <input type="hidden" name="_subject" value="Novo Contato do Site Novo Belém">

                    <div class="form-group">
                        <label for="nome">Nome *</label>
                        <input type="text" id="nome" name="nome" required>
                    </div>

                    <div class="form-group">
                        <label for="email">E-mail *</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="form-group">
                        <label for="telefone">Telefone *</label>
                        <input type="tel" id="telefone" name="telefone" required>
                    </div>

                    <div class="form-group">
                        <label for="produto">Produto de Interesse *</label>
                        <select id="produto" name="produto" required>
                            <option value="">Selecione um produto</option>
                            <% produtos.forEach(prod=> { %>
                                <option value="<%= prod.nome %>">
                                    <%= prod.nome %> - R$ <%= prod.preco %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="quantidade">Quantidade Desejada *</label>
                        <input type="number" id="quantidade" name="quantidade" min="1" required>
                    </div>

                    <div class="form-group">
                        <label for="mensagem">Mensagem</label>
                        <textarea id="mensagem" name="mensagem" rows="5"></textarea>
                    </div>

                    <button type="submit" class="btn btn-azul">Enviar Mensagem</button>
                </form>
            </div>
        </div>
    </section>

    <footer class="rodape">
        <div class="container">
            <p class="rodape-marca">&copy; 2026 Novo Belém - Argamassa e Ferragem. Todos os direitos reservados.</p>
            <p class="rodape-info">Rua Próspero Ambrósio Pesce, 220 - Bairro Passo do Príncipe - Bagé, RS - CEP
                96400-000</p>
        </div>
    </footer>

    <div class="modal-overlay" id="modalProduto" aria-hidden="true">
        <div class="modal-produto" role="dialog" aria-modal="true" aria-labelledby="modalProdutoNome">
            <button type="button" class="modal-fechar" id="modalFechar" aria-label="Fechar">&times;</button>
            <div class="modal-corpo">
                <div class="modal-imagem">
                    <img id="modalProdutoImagem" src="" alt="">
                </div>
                <div class="modal-info">
                    <span class="badge-estoque ok" id="modalProdutoEstoque">Em estoque</span>
                    <h3 id="modalProdutoNome"></h3>
                    <p class="preco" id="modalProdutoPreco"></p>
                    <p class="categoria" id="modalProdutoCategoria"></p>

                    <div class="modal-avaliacao">
                        <div class="modal-estrelas-visual" id="modalEstrelasVisual"></div>
                        <span class="modal-nota-texto" id="modalNotaTexto"></span>
                        <button type="button" class="btn-avaliar" id="btnAvaliar">⭐ Avaliar</button>
                    </div>
                    <div class="modal-estrelas-input" id="modalEstrelasInput" style="display:none">
                        <span class="estrela-input" data-valor="1">★</span>
                        <span class="estrela-input" data-valor="2">★</span>
                        <span class="estrela-input" data-valor="3">★</span>
                        <span class="estrela-input" data-valor="4">★</span>
                        <span class="estrela-input" data-valor="5">★</span>
                    </div>

                    <p class="modal-descricao" id="modalProdutoDescricao"></p>
                    <div class="modal-acoes">
                        <a href="#" id="modalProdutoWhatsapp" class="btn btn-whatsapp" target="_blank"
                            rel="noopener">Pedir via WhatsApp</a>
                        <a href="#contato" class="btn btn-azul btn-orcamento" id="modalProdutoOrcamento">Solicitar
                            Orçamento</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalContato" aria-hidden="true">
        <div class="modal-produto modal-contato" role="dialog" aria-modal="true" aria-labelledby="modalContatoTitulo">
            <button type="button" class="modal-fechar" id="modalContatoFechar" aria-label="Fechar">&times;</button>
            <div class="modal-contato-corpo">
                <div class="modal-contato-cabecalho">
                    <span class="icon-grande">💬</span>
                    <h3 id="modalContatoTitulo">Fale Conosco</h3>
                    <p>Ficou com alguma dúvida que não seja sobre orçamento? Escolha a forma de contato que preferir.</p>
                </div>
                <div class="modal-contato-lista">
                    <a href="tel:<%= DADOS_CONTATO.telefoneLink %>" class="contato-item">
                        <span class="contato-icone">📞</span>
                        <span class="contato-texto">
                            <strong>Telefone</strong>
                            <small><%= DADOS_CONTATO.telefone %></small>
                        </span>
                        <span class="contato-seta">→</span>
                    </a>
                    <a href="mailto:<%= DADOS_CONTATO.email %>" class="contato-item">
                        <span class="contato-icone">✉️</span>
                        <span class="contato-texto">
                            <strong>E-mail</strong>
                            <small><%= DADOS_CONTATO.email %></small>
                        </span>
                        <span class="contato-seta">→</span>
                    </a>
                    <a href="<%= DADOS_CONTATO.whatsappLink %>?text=<%= encodeURIComponent(DADOS_CONTATO.whatsappTexto) %>"
                        class="contato-item" target="_blank" rel="noopener">
                        <span class="contato-icone">💬</span>
                        <span class="contato-texto">
                            <strong>WhatsApp</strong>
                            <small>Conversar agora</small>
                        </span>
                        <span class="contato-seta">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <a href="https://wa.me/5553991027296?text=Ol%C3%A1!%20Quero%20saber%20mais!" target="_blank" rel="noopener"
        class="whatsapp-float" aria-label="Falar no WhatsApp">
        <svg viewBox="0 0 32 32" aria-hidden="true">
            <path
                d="M16 2C8.3 2 2 8.3 2 16c0 2.7 0.8 5.2 2.1 7.4L2 30l6.8-2.1C11 29.5 13.4 30 16 30c7.7 0 14-6.3 14-14S23.7 2 16 2zm0 25.5c-2.4 0-4.6-0.7-6.5-1.8l-0.5-0.3-4 1.2 1.2-3.9-0.3-0.5C4.3 20 3.5 18 3.5 16 3.5 9.1 9.1 3.5 16 3.5S28.5 9.1 28.5 16 22.9 27.5 16 27.5zm7.1-9.7c-0.4-0.2-2.3-1.1-2.6-1.2-0.3-0.2-0.6-0.2-0.8 0.2-0.2 0.3-0.9 1.2-1.1 1.4-0.2 0.2-0.4 0.2-0.8 0.1-0.4-0.2-1.6-0.6-3.1-1.9-1.1-1-1.9-2.2-2.1-2.6-0.2-0.4 0-0.6 0.2-0.8 0.2-0.2 0.4-0.4 0.6-0.7 0.2-0.2 0.3-0.4 0.4-0.7 0.1-0.3 0.1-0.5 0-0.7-0.1-0.2-0.8-2-1.1-2.7-0.3-0.7-0.6-0.6-0.8-0.6h-0.7c-0.2 0-0.6 0.1-0.9 0.4-0.3 0.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4c0.2 0.2 2.4 3.6 5.8 5.1 0.8 0.3 1.4 0.5 1.9 0.7 0.8 0.2 1.5 0.2 2.1 0.1 0.6-0.1 2-0.8 2.3-1.6 0.3-0.8 0.3-1.5 0.2-1.7-0.1-0.2-0.3-0.3-0.7-0.4z" />
        </svg>
    </a>

    <button id="voltar-topo" class="voltar-topo" type="button" aria-label="Voltar ao topo">&uarr;</button>

    <script>
        function removerAcentos(texto) {
            if (!texto) return "";
            return texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        }

        const inputPesquisa = document.getElementById("pesquisa");
        const filtroPesquisa = document.getElementById("filtroPesquisa");
        const secaoCategorias = document.getElementById("servicos");
        const secaoProdutos = document.getElementById("produtos");

        const categoriasLista = document.querySelectorAll(".card-servico");
        const produtos = document.querySelectorAll(".card-produto");

        let produtosVisiveis = 4;
        let categoriasVisiveis = 5;
        let categoriaAtiva = "todos";
        const pillsCategoria = document.querySelectorAll(".pill-categoria");

        function atualizarProdutos() {
            let contador = 0;
            produtos.forEach(p => {
                if (p.dataset.match === "0") {
                    p.style.display = "none";
                    return;
                }
                contador++;
                p.style.display = contador <= produtosVisiveis ? "" : "none";
            });

            document.getElementById("btnVerMais").style.display =
                produtosVisiveis >= contador ? "none" : "inline-block";

            document.getElementById("btnVerMenos").style.display =
                produtosVisiveis > 4 ? "inline-block" : "none";
        }

        function atualizarCategorias() {
            let contador = 0;
            categoriasLista.forEach(c => {
                if (c.dataset.match === "0") {
                    c.style.display = "none";
                    return;
                }
                contador++;
                c.style.display = contador <= categoriasVisiveis ? "" : "none";
            });

            document.getElementById("btnVerMaisCategorias").style.display =
                categoriasVisiveis >= contador ? "none" : "inline-block";

            document.getElementById("btnVerMenosCategorias").style.display =
                categoriasVisiveis > 5 ? "inline-block" : "none";
        }

        // ----- Sugestões de pesquisa ("Você quis dizer?") -----
        const SINONIMOS = {
            // Elétrica / Iluminação
            "luz": ["lampada", "luminaria", "iluminacao", "eletrica", "eletrico"],
            "iluminacao": ["lampada", "luminaria", "eletrica", "eletrico"],
            "eletrico": ["eletrica", "tomada", "interruptor", "lampada", "fio", "disjuntor", "instalacao"],
            "eletrica": ["eletrico", "tomada", "interruptor", "lampada", "fio", "disjuntor", "instalacao"],
            "tomada": ["interruptor", "eletrica", "eletrico", "fio", "extensao", "plugue"],
            "interruptor": ["tomada", "eletrica", "eletrico", "fio", "botao"],
            "fio": ["cabo", "eletrico", "tomada", "interruptor", "instalacao"],
            "plugue": ["tomada", "extensao", "adaptador"],
            "extensao": ["plugue", "tomada", "fio", "eletrico"],
            "disjuntor": ["eletrica", "eletrico", "quadro de luz", "tomada"],
            "instalacao": ["eletrica", "hidraulica", "pintura", "gesso"],

            // Hidráulica / Encanamento
            "agua": ["hidraulica", "encanamento", "cano", "canos", "tubo", "tubos", "conexao", "registro", "torneira", "pvc", "valvula", "mangueira", "sifao", "ralo", "vazamento"],
            "hidraulica": ["cano", "canos", "tubo", "tubos", "conexao", "registro", "torneira", "agua", "pvc", "ralo", "sifao"],
            "encanamento": ["cano", "canos", "tubo", "tubos", "hidraulica", "agua", "torneira"],
