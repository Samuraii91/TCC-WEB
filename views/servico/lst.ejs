<%- include('../cabecalho.ejs') %>

  <div class="container">
    <h2>Lista de Serviços</h2>

    <!-- 🔹 Barra superior (pesquisa + botão novo serviço) -->
    <div class="top-bar">
      <div class="search-box">
        <input
          type="text"
          id="searchInput"
          placeholder="Pesquisar serviço..."
          onkeyup="filtrarTabela()" />
      </div>

      <div class="new-btn">
        <a href="/servico/add"><button>+ Novo Serviço</button></a>
      </div>
    </div>

    <!-- 🔹 Tabela de serviços -->
    <table id="tabelaServicos">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Descrição</th>
          <th>Preço</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% servicos.forEach(s => { %>
          <tr>
            <td><%= s.nome %></td>
            <td><%= s.descricao %></td>
            <td>R$ <%= Number(s.preco || 0).toFixed(2) %></td>
            <td>
              <div class="action-buttons">
                <a href="/servico/edt/<%= s._id %>" class="edit">Editar</a>
                <a href="/servico/del/<%= s._id %>" class="del"
                   onclick="return confirm('Deseja realmente excluir este serviço?')">
                  Excluir
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <br />
    <div style="margin-top: 20px;">
    </div>
  </div>

  <script>
    function removerAcentos(texto) {
      return (texto || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    }

    function filtrarTabela() {
      const input = document.getElementById("searchInput");
      const filtro = removerAcentos(input.value);
      const linhas = document.querySelectorAll("#tabelaServicos tbody tr");

      linhas.forEach(linha => {
        const texto = removerAcentos(linha.innerText);
        linha.style.display = texto.includes(filtro) ? "" : "none";
      });
    }
  </script>

  <%- include('../rodape.ejs') %>
