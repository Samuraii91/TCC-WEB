<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title>Adicionar Entrega</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../cabecalho.ejs') %>

  <div class="container">
    <h2>Adicionar Entrega</h2>

    <form action="/entrega/add" method="POST" class="form-padrao">
      <div class="form-group">
        <label>Produtos *</label>
        <div id="itensEntrega"></div>
        <button type="button" id="btnAdicionarItem" class="btn-salvar btn-adicionar-entrega">+ Adicionar produto</button>
      </div>

      <div class="form-group">
        <label for="cliente">Cliente:</label>
        <input type="text" id="cliente" name="cliente" required />
      </div>

      <div class="form-group">
        <label for="endereco">Endereço:</label>
        <input type="text" id="endereco" name="endereco" required />
      </div>

      <div class="form-group">
        <label for="status">Status:</label>
        <select id="status" name="status" required>
          <option value="Pendente">Pendente</option>
          <option value="Em rota">Em rota</option>
          <option value="Entregue">Entregue</option>
        </select>
      </div>

      <div class="form-group">
        <label for="data">Data de Entrega:</label>
        <input type="date" id="data" name="data" required />
      </div>

      <div class="botoes-centro">
        <button type="submit" class="btn-salvar">💾 Adicionar</button>
      </div>
    </form>

    <div class="voltar-centro">
      <a href="/entrega/lst" class="btn-voltar">↩ Voltar</a>
    </div>
  </div>

  <%- include('../rodape.ejs') %>

  <script>
    const PRODUTOS_ENTREGA = <%- JSON.stringify(produtos.map(p => ({ id: p._id.toString(), nome: p.nome }))) %>;

    const itensEntrega = document.getElementById("itensEntrega");
    const btnAdicionarItem = document.getElementById("btnAdicionarItem");

    function atualizarOpcoesDisponiveis() {
      const linhas = Array.from(itensEntrega.querySelectorAll(".item-entrega"));
      const selecionados = linhas.map(l => l.querySelector("select[name='produto[]']").value).filter(Boolean);
      linhas.forEach(linha => {
        const select = linha.querySelector("select[name='produto[]']");
        Array.from(select.options).forEach(opt => {
          if (opt.value === "") return;
          opt.disabled = selecionados.includes(opt.value) && opt.value !== select.value;
        });
      });
    }

    function criarLinhaEntrega(idSelecionado) {
      const linha = document.createElement("div");
      linha.className = "item-entrega";

      const select = document.createElement("select");
      select.name = "produto[]";
      const optVazio = document.createElement("option");
      optVazio.value = "";
      optVazio.textContent = "Selecione um produto";
      select.appendChild(optVazio);
      PRODUTOS_ENTREGA.forEach(p => {
        const opt = document.createElement("option");
        opt.value = p.id;
        opt.textContent = p.nome;
        select.appendChild(opt);
      });
      if (idSelecionado && PRODUTOS_ENTREGA.some(p => p.id === idSelecionado)) select.value = idSelecionado;

      const qtdInput = document.createElement("input");
      qtdInput.type = "number";
      qtdInput.name = "quantidadeItem[]";
      qtdInput.min = "1";
      qtdInput.value = "1";
      qtdInput.title = "Quantidade";

      const btnRemover = document.createElement("button");
      btnRemover.type = "button";
      btnRemover.className = "btn-remover-item";
      btnRemover.title = "Remover produto";
      btnRemover.textContent = "×";
      btnRemover.addEventListener("click", () => {
        linha.remove();
        atualizarOpcoesDisponiveis();
        if (itensEntrega.querySelectorAll(".item-entrega").length === 0) criarLinhaEntrega();
      });

      select.addEventListener("change", atualizarOpcoesDisponiveis);

      linha.appendChild(select);
      linha.appendChild(qtdInput);
      linha.appendChild(btnRemover);

      itensEntrega.appendChild(linha);
      atualizarOpcoesDisponiveis();
      return linha;
    }

    btnAdicionarItem.addEventListener("click", () => criarLinhaEntrega());

    if (itensEntrega.querySelectorAll(".item-entrega").length === 0) {
      criarLinhaEntrega();
    }
  </script>
</body>
</html>